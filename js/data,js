  /* =======================================================
     23 — GLOBAL DATA API
     ======================================================= */

  const ShadidData = {

    version:
      "1.0.0",

    lastUpdated:
      "2026",

    identity,

    education,

    academicInterests,

    skills,

    books,

    artworks,

    artCompetitions,

    architectureProjects,

    digitalProjects,

    game,

    teaching,

    englishCourses,

    extracurricular,

    videos,

    certificates,

    documents,

    socialLinks,

    locations,

    life,

    physicalPortfolio,

    statistics,

    aiKnowledge,


    /* -------------------------------------------------------
       Utility Methods
       ------------------------------------------------------- */

    getEducation() {
      return education;
    },

    getSkills() {
      return skills;
    },

    getBooks() {
      return books;
    },

    getArtworks() {
      return artworks;
    },

    getArchitectureProjects() {
      return architectureProjects;
    },

    getDigitalProjects() {
      return digitalProjects;
    },

    getCertificates() {
      return certificates;
    },

    getDocuments() {
      return documents;
    },

    getVideos() {
      return videos;
    },

    getSocialLinks() {
      return socialLinks.filter(
        (item) => item.enabled
      );
    },


    /* -------------------------------------------------------
       Find Any Portfolio Item
       ------------------------------------------------------- */

    findById(id) {
      const collections = [
        education,
        skills,
        books,
        artworks,
        artCompetitions,
        architectureProjects,
        digitalProjects,
        teaching,
        englishCourses,
        extracurricular,
        videos,
        certificates,
        documents,
        socialLinks
      ];

      for (const collection of collections) {
        const found = collection.find(
          (item) => item.id === id
        );

        if (found) {
          return found;
        }
      }

      return null;
    },


    /* -------------------------------------------------------
       Search Portfolio Knowledge
       ------------------------------------------------------- */

    search(query) {
      if (!query) return [];

      const normalized =
        String(query)
          .toLowerCase()
          .trim();

      const collections = [
        education,
        skills,
        books,
        artworks,
        architectureProjects,
        digitalProjects,
        videos,
        certificates,
        documents
      ];

      const results = [];

      collections.forEach((collection) => {
        collection.forEach((item) => {

          const searchableText =
            JSON.stringify(item)
              .toLowerCase();

          if (
            searchableText.includes(
              normalized
            )
          ) {
            results.push(item);
          }
        });
      });

      return results;
    },


    /* -------------------------------------------------------
       Find Incomplete Data
       ------------------------------------------------------- */

    getIncompleteItems() {
      const incomplete = [];

      const collections = [
        education,
        artworks,
        architectureProjects,
        digitalProjects,
        videos,
        certificates,
        documents,
        socialLinks
      ];

      collections.forEach((collection) => {

        collection.forEach((item) => {

          const emptyFields = [];

          Object.entries(item).forEach(
            ([key, value]) => {

              if (
                value === "" ||
                value === null ||
                value === undefined
              ) {
                emptyFields.push(key);
              }

              if (
                Array.isArray(value) &&
                value.length === 0
              ) {
                emptyFields.push(key);
              }
            }
          );

          if (emptyFields.length) {
            incomplete.push({
              id: item.id,
              title:
                item.title ||
                item.name ||
                item.institution ||
                item.author ||
                item.id,

              emptyFields
            });
          }
        });
      });

      return incomplete;
    },


    /* -------------------------------------------------------
       Generate AI Context
       ------------------------------------------------------- */

    getAIContext() {
      return {
        identity: this.identity,

        education: this.education,

        skills: this.skills,

        interests:
          this.academicInterests,

        artworks: this.artworks,

        architecture:
          this.architectureProjects,

        digital:
          this.digitalProjects,

        books:
          this.books,

        game:
          this.game,

        statistics:
          this.statistics,

        incomplete:
          this.getIncompleteItems()
      };
    }
  };


